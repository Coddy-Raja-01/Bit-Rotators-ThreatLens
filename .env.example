# Local API server
HOST=127.0.0.1
PORT=8000
THREATLENS_DB_PATH=threatlens.db
SESSION_SECRET=
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional external AI. Disabled by default; local explanations remain available.
USE_EXTERNAL_AI=false
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2

# Optional threat-intelligence providers
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
URLHAUS_API_KEY=
PHISHTANK_API_KEY=
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional EVM registry. Local Docker Compose overrides the RPC/network values.
WEB3_PROVIDER_URI=http://127.0.0.1:8545
WEB3_NETWORK=Local Anvil Chain
WEB3_STARTUP_TIMEOUT=90
THREAT_REGISTRY_ADDRESS=
THREAT_REGISTRY_DEPLOYMENT_BLOCK=0
WEB3_RELAYER_ADDRESS=
WEB3_RELAYER_PRIVATE_KEY=

# Optional demo account seed; set a unique password only when explicitly seeding.
DEMO_USERNAME=sec_analyst
DEMO_EMAIL=analyst@threatlens.local
DEMO_PASSWORD=

# Vercel build-time setting (not read by the Python backend).
# Set to the HTTPS Render API origin, e.g. https://your-service.onrender.com
THREATLENS_API_BASE_URL=
