# ThreatLens Environment Configuration

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=False

# AI Layer Settings
# If USE_EXTERNAL_AI is false or keys are blank, ThreatLens uses its deterministic local explainer
USE_EXTERNAL_AI=false
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Web3 / ThreatRegistry Settings
# Public testnet (Sepolia or Polygon Amoy) or local Hardhat/Anvil node
WEB3_PROVIDER_URI=http://127.0.0.1:8545
WEB3_NETWORK=Local Anvil Chain
WEB3_RELAYER_ADDRESS=
WEB3_RELAYER_PRIVATE_KEY=
THREAT_REGISTRY_ADDRESS=
WEB3_NETWORK=local

# Optional external threat intelligence feed API keys
# If left blank, ThreatLens operates in high-fidelity offline mode using local heuristics & datasets.
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
URLHAUS_API_KEY=
PHISHTANK_API_KEY=
OPENPHISH_FEED_URL=https://openphish.com/feed.txt

# Optional email alerting for watchlisted domains (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@threatlens.local
